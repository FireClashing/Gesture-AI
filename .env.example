# Copy to .env.local. All values are optional.

# auto (default): use public/models/gesture-model.json if present, otherwise the FastAPI server
# browser: in-browser model only    api: FastAPI server only
NEXT_PUBLIC_INFERENCE=auto

# FastAPI server (only used when inference falls back to / is set to "api")
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Below this confidence the result is shown as UNKNOWN (keep equal to SIGNA_CONFIDENCE_THRESHOLD on the API)
NEXT_PUBLIC_CONFIDENCE_THRESHOLD=0.65

# Self-hosted MediaPipe assets (created by `npm run setup:assets`)
# NEXT_PUBLIC_MEDIAPIPE_WASM_URL=/mediapipe/wasm
# NEXT_PUBLIC_HAND_MODEL_URL=/models/hand_landmarker.task

# --- Python API (set in the shell that runs `npm run api`) ---
# SIGNA_MODEL_PATH=ml/models/gesture_model.joblib
# SIGNA_CONFIDENCE_THRESHOLD=0.65
# SIGNA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
